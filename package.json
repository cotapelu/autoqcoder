{
  "name": "autoqcoder",
  "version": "2.1.0",
  "description": "Self-optimizing prompt engine for AI coding agents. Production-ready code generation with self-evolution, mental testing, 10+ skills, and comprehensive security audit framework.",
  "main": "AGENTS.md",
  "files": [
    "AGENTS.md",
    "AUTO-CONTINUE.md",
    "GOAL.md",
    "README.md",
    "LICENSE",
    "Makefile",
    "docs/",
    "skills/",
    "tests/",
    "scripts/"
  ],
  "scripts": {
    "test": "npm run test:prompts",
    "test:prompts": "node --test tests/*.test.js",
    "lint": "echo \"No linter - manual review required\"",
    "type-check": "echo \"No TypeScript source - prompt engine is markdown-based\"",
    "build": "echo \"No build step - prompt engine is markdown-based\"",
    "quality": "make quality",
    "coverage": "npm run test:prompts",
    "agent:start": "echo \"Agent entrypoint: AGENTS.md + AUTO-CONTINUE.md\"",
    "agent:once": "echo \"Run: npm run test:prompts && npm run self-score && npm run check:evolution\"",
    "agent:dev": "echo \"Run: npm run quality\"",
    "prepare": "node scripts/postinstall.js",
    "postinstall": "node scripts/postinstall.js",
    "validate:all": "npm run test:prompts && npm run check:evolution && npm run self-score",
    "check:evolution": "node scripts/check-evolution-files.js",
    "self-score": "node scripts/calculate-self-score.js",
    "setup": "echo \"autoqcoder is ready. Run: make quality\""
  },
  "keywords": [
    "ai",
    "coding-agent",
    "prompt-engineering",
    "production-ready",
    "quality-gates",
    "self-evolving",
    "mental-testing",
    "security-audit",
    "clean-architecture",
    "repository-pattern",
    "typescript",
    "nodejs",
    "dotnet",
    "angular",
    "react",
    "go",
    "rust",
    "python"
  ],
  "author": "autoqcoder team <team@autoqcoder.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/autoqcoder/autoqcoder.git"
  },
  "bugs": {
    "url": "https://github.com/autoqcoder/autoqcoder/issues"
  },
  "homepage": "https://github.com/autoqcoder",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "husky": ">=8.0.0"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
